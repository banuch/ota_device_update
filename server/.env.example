# Copy to .env and fill in. Never commit .env.
PORT=8080

# Root secret. Each device key = HMAC_SHA256(MASTER_SECRET, IMEI).
# Changing it invalidates every provisioned device key.
MASTER_SECRET=change-me-to-a-long-random-string

# API key for scripts: "Authorization: Bearer <ADMIN_TOKEN>" = admin rights.
# The dashboard uses user logins instead (npm run user:add -- <name> --role admin).
ADMIN_TOKEN=change-me-admin-token

# Optional
# DATA_DIR=./data
# TS_WINDOW_SEC=300
# TOKEN_TTL_SEC=600
# DEFAULT_CHECK_INTERVAL_SEC=86400
# AUTO_REGISTER=true          # false = only pre-registered IMEIs may check
# MAX_FIRMWARE_BYTES=8388608

# Dashboard login
# SESSION_IDLE_SEC=28800       # 8 h without activity -> signed out
# SESSION_MAX_SEC=86400        # 24 h absolute
# LOGIN_MAX_FAILS=5
# LOGIN_LOCK_SEC=900
# COOKIE_SECURE=auto           # auto = Secure flag only over HTTPS; always / never
# TRUST_PROXY=loopback         # set when nginx terminates HTTPS on the same host
