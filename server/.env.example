# Copy to .env and fill in. Never commit .env.
PORT=8080

# Root secret. Each device key = HMAC_SHA256(MASTER_SECRET, IMEI).
# Changing it invalidates every provisioned device key.
MASTER_SECRET=change-me-to-a-long-random-string

# API key for scripts: "Authorization: Bearer <ADMIN_TOKEN>" = admin rights.
# The dashboard uses user logins instead (npm run user:add -- <name> --role admin).
ADMIN_TOKEN=change-me-admin-token

# Optional
# DATA_DIR=./data
# TS_WINDOW_SEC=300
# TOKEN_TTL_SEC=600
# DEFAULT_CHECK_INTERVAL_SEC=86400
# MAX_FIRMWARE_BYTES=8388608

# Automatic registration: a new device sends its IMEI + ECDH public key to
# /ota/register and receives its key encrypted (see README).
#   approval = device waits in the dashboard until an admin approves it
#   auto     = approved at once (lab / factory use only)
#   off      = only pre-registered IMEIs with a manually set key may check
# REGISTRATION_MODE=approval
# REGISTER_MAX_PENDING=500     # refuse new requests while this many wait
# REGISTER_POLL_SEC=600        # how often a waiting device asks again

# Dashboard login
# SESSION_IDLE_SEC=28800       # 8 h without activity -> signed out
# SESSION_MAX_SEC=86400        # 24 h absolute
# LOGIN_MAX_FAILS=5
# LOGIN_LOCK_SEC=900
# COOKIE_SECURE=auto           # auto = Secure flag only over HTTPS; always / never
# TRUST_PROXY=loopback         # set when nginx terminates HTTPS on the same host
